<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Public HTTP/HTTPS is allowed only for this Internet-connectivity probe. -->
    <add key="ConnectivityCheckUrl" value="http://www.msftconnecttest.com/connecttest.txt" />
    <!-- The reverse TCP endpoint remains restricted to loopback/private literal addresses. -->
    <add key="TcpHost" value="127.0.0.1" />
    <add key="TcpPort" value="19090" />
    <!-- Replace this placeholder before installing or starting the service. -->
    <add key="SharedToken" value="CHANGE_ME_WITH_A_PRIVATE_TOKEN" />
    <add key="ConnectTimeoutMilliseconds" value="5000" />
    <add key="ReconnectDelayMilliseconds" value="5000" />
    <add key="LogPath" value="%PROGRAMDATA%\NT230.R12.ANTT_Lab2.ReverseShell\service.log" />
    <!-- Empty means the installed executable directory; dir cannot leave this root. -->
    <add key="CommandRoot" value="" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
